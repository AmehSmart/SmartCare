NODE_ENV=development
API_PORT=3000
AUDIT_PORT=3001
# Neon pooled URLs are used by the running services. Direct URLs are used by Prisma migrations.
CLINICAL_DATABASE_URL=postgresql://USER:PASSWORD@CLINICAL-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
CLINICAL_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@CLINICAL-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
AUDIT_DATABASE_URL=postgresql://USER:PASSWORD@AUDIT-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
AUDIT_MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@AUDIT-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUDIT_SERVICE_URL=http://localhost:3001
AUDIT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PASSPORT_SIGNING_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PASSPORT_SIGNING_KEY_ID=dev-2026-01
AUDIT_CHECKPOINT_SIGNING_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=
TOTP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Vite's development server uses port 5173 unless configured otherwise.
ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
