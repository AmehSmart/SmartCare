{
  "name": "kofa-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented access-control and tamper-evident audit backend for Kofa.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -b",
    "clean": "node scripts/clean.mjs",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:audit": "tsx watch apps/audit-service/src/main.ts",
    "start:api": "node dist/apps/api/main.js",
    "start:audit": "node dist/apps/audit-service/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm db:generate && tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema prisma/clinical/schema.prisma && prisma generate --schema prisma/audit/schema.prisma",
    "db:migrate:clinical": "prisma migrate deploy --schema prisma/clinical/schema.prisma",
    "db:migrate:audit": "prisma migrate deploy --schema prisma/audit/schema.prisma",
    "db:migrate": "pnpm db:migrate:clinical && pnpm db:migrate:audit",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:import:synthea": "tsx scripts/synthea/import.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@kofa/contracts": "workspace:*",
    "@kofa/core": "workspace:*",
    "@kofa/passport-browser": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "latest",
    "@prisma/client": "6.19.1",
    "@noble/hashes": "1.8.0",
    "class-transformer": "latest",
    "class-validator": "latest",
    "fastify": "5.12.4",
    "jose": "latest",
    "otplib": "latest",
    "pg": "latest",
    "prom-client": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "tweetnacl": "latest",
    "undici": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prisma": "6.19.1",
    "supertest": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
