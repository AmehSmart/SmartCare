# SmartCare frontend configuration
#
# Point the frontend at the real Kofa backend. When this is set, the app calls
# the live API (POST /v1/auth/login, /v1/patients, /v1/audit/events, ...).
# Set VITE_USE_MOCK_DATA=true only for an explicit fixture-only development session.
#
# The Kofa API defaults to http://localhost:3000 (see kofa-backend/README.md).
VITE_API_BASE_URL=http://localhost:3000
